# .gitignore for GitHub Pages Blog

# OS Files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Optional: Uncomment if you're using Node.js for local development
# node_modules/
# package-lock.json

# Sensitive configuration files with API endpoints
WEBHOOK_TRANSFORMER.md
FORMSPARK_WEBHOOK_SETUP.md

# Subscriber data managed by GitHub Actions
subscribers.json
